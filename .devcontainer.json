{
  "name": "pipelines-rj-smas (dev)",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1.0.0": {
      "version": "0.12.5"
    },
    "ghcr.io/joshuanianji/devcontainer-features/google-cloud-cli:1.0.0": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/queries"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "dbt.dbtCoreIntegration": "other",
        "dbt.pythonInterpreter": [
          "${containerWorkspaceFolder}/.venv/bin/python"
        ],
        "dbt.queryLimit": 500,
        "dbt.enableNewQueryPreview": true,
        "files.associations": {
          "*.sql": "jinja-sql"
        },
        "workbench.colorTheme": "Sweet Dracula",
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "terminal.integrated.initialHint": false,
        "dbt.perspectiveTheme": "Vintage",
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false
      },
      "extensions": [
        "ms-python.python",
        "innoverio.vscode-dbt-power-user",
        "googlecloudtools.cloudcode",
        "github.vscode-pull-request-github",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode",
  "postAttachCommand": "bash .devcontainer/extensions.sh"
}
